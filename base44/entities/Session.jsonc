{
  "name": "Session",
  "type": "object",
  "description": "One session per connected repo: conversation state, linked repo, and the GitHubConnection that backs it. Owned by a user via owner_email (not created_by), so a backend function can create a session on the user's behalf and the user can still read it.",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "Email of the Base44 user who owns this session. RLS keys off this so ownership survives service-role creation."
    },
    "title": {
      "type": "string",
      "description": "Human-readable name for the session"
    },
    "repo_full_name": {
      "type": "string",
      "description": "Full GitHub repo name (owner/repo) this session is connected to"
    },
    "github_connection_id": {
      "type": "string",
      "description": "Reference to the GitHubConnection holding the OAuth token for this repo"
    },
    "conversation_state": {
      "type": "object",
      "description": "Opaque conversation state blob (e.g. last processed message id, summary) managed by the assistant",
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "owner_email",
    "repo_full_name",
    "github_connection_id"
  ],
  // owner_email is a custom field, so RLS addresses it under `data.`. A user may
  // only create sessions they own; service-role backend calls bypass RLS.
  "rls": {
    "create": {
      "data.owner_email": "{{user.email}}"
    },
    "read": {
      "data.owner_email": "{{user.email}}"
    },
    "update": {
      "data.owner_email": "{{user.email}}"
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  }
}
