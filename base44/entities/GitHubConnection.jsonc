{
  "name": "GitHubConnection",
  "type": "object",
  "description": "An account-level GitHub OAuth grant. Created only by the github-oauth-callback function under the service role. Repo selection happens afterwards, per Session.",
  "properties": {
    "owner_email": {
      "type": "string",
      "description": "Email of the Base44 user this connection belongs to. Set explicitly by the callback, which runs under the service role and therefore cannot rely on created_by."
    },
    "owner_id": {
      "type": "string",
      "description": "Base44 user id of the owner"
    },
    "github_username": {
      "type": "string",
      "description": "GitHub login of the user who authorized this connection"
    },
    "github_user_id": {
      "type": "number",
      "description": "Numeric GitHub user id. Stable across username changes, so this is the real identity key."
    },
    "scope": {
      "type": "string",
      "description": "OAuth scopes actually granted by GitHub, as returned by the token exchange"
    },
    "access_token": {
      "type": "string",
      "description": "Server-side OAuth access token. Never leaves the backend.",
      // Field-level lockout: no client can read or write this, not even the
      // owning user. Only service-role calls from backend functions see it.
      "rls": {
        "read": false,
        "write": false
      }
    },
    "token_type": {
      "type": "string",
      "default": "bearer"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    }
  },
  "required": [
    "owner_email",
    "github_username",
    "github_user_id",
    "access_token"
  ],
  // Connections are minted only by the OAuth callback (service role), so
  // clients get read + delete (to disconnect) and nothing else.
  //
  // Custom fields are addressed under `data.` in RLS conditions (built-in
  // fields like created_by are top-level; custom properties are not). Without
  // the prefix the condition references a non-existent path and matches no
  // rows — which silently hides every service-role-created connection from its
  // own owner.
  "rls": {
    "create": false,
    "read": {
      "data.owner_email": "{{user.email}}"
    },
    "update": false,
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  }
}
